# Shared settings for Docker Compose and backend commands. Copy this file to .env.
APP_ENV=development
PORT=3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=uemp_demo
POSTGRES_USER=uemp
POSTGRES_PASSWORD=uemp
REDIS_URL=redis://127.0.0.1:6379
ACCESS_TOKEN_SECRET=3A75E6D0B3ADE093D871B5D335CFCA499E649BDAC7092543A5CD63F87F727F74
REFRESH_TOKEN_SECRET=8FC6ACFEBE65673211F9D47B945AF053F0B5E04978C3A7D0C78F4AD78D4BC68E
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Optional. Set both to enable OpenAPI docs outside production.
SWAGGER_USER=uemp
SWAGGER_PASSWORD=uemp
# Optional production endpoint for OTLP trace and metric export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Used by npm run admin:bootstrap only.
BOOTSTRAP_ADMIN_EMAIL=super-admin@demo.example.test
BOOTSTRAP_ADMIN_PASSWORD=12345678
# Required for automatic first-start demo seeding in Docker Compose.
# Use at least 7 characters and no more than 72 UTF-8 bytes.
DEMO_SEED_PASSWORD=12345678
# Optional Compose port and public-origin overrides. Empty values use localhost defaults.
STUDENT_PORT=3001
ADMIN_PORT=3002
PUBLIC_API_URL=
STUDENT_APP_ORIGIN=
