{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "STUDENT_API_URL",
    "STUDENT_APP_ORIGIN",
    "VITE_API_URL",
    "UEMP_STANDALONE"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
