APP_ENV=development
PORT=3000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=uemp
POSTGRES_USER=uemp
POSTGRES_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Optional. Set both to enable OpenAPI docs outside production.
SWAGGER_USER=
SWAGGER_PASSWORD=
# Optional production endpoint for OTLP trace and metric export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Used by npm run admin:bootstrap only.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Used only by npm run demo:seed on a dedicated non-production database.
DEMO_SEED_PASSWORD=
# Optional Compose port and public-origin overrides. Empty values use localhost defaults.
STUDENT_PORT=3001
ADMIN_PORT=3002
PUBLIC_API_URL=
STUDENT_APP_ORIGIN=
