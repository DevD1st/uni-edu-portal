{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "#core/*.js": ["./src/core/*.ts"],
      "#shared/*.js": ["./src/shared/*.ts"],
      "#modules/*.js": ["./src/modules/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
